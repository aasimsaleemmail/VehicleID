<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vehicle Databases"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NHTSA vPIC (Global/US) — Approx. 178 MB"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/txtNhtsaStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Not Installed" />
    <Button
        android:id="@+id/btnInstallNhtsa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="Install" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Global Open Dataset — Variable size"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/txtOpenStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Available" />
    <Button
        android:id="@+id/btnInstallOpen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
